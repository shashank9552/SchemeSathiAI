{
  "name": "schemesathi",
  "version": "1.0.0",
  "description": "Multilingual (Hindi + English) RAG assistant for Indian government welfare schemes with grounded citations",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "test": "npm --prefix server run test",
    "ingest": "npm --prefix server run ingest",
    "inspect:pdf": "npm --prefix server run inspect:pdf",
    "eval": "npm --prefix server run eval"
  },
  "keywords": [
    "rag",
    "welfare-schemes",
    "gemini",
    "mongodb-atlas-vector-search",
    "multilingual",
    "hindi",
    "citations"
  ],
  "author": "SchemeSathi Team",
  "license": "ISC"
}
