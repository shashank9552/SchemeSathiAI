# ==============================================================================
# SchemeSathi Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas Database & Vector Search
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=schemesathi
MONGODB_COLLECTION_NAME=scheme_chunks
ATLAS_VECTOR_INDEX_NAME=vector_index

# Model & Provider Configuration
# Supported providers: gemini (extensible to openai, ollama, etc.)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embedding Vector Dimension
# Must match the model dimension: 768 for text-embedding-004
# Atlas Vector Search index definition MUST use this identical dimension.
EMBEDDING_DIMENSIONS=768

# RAG Ingestion & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# RAG Retrieval & Guardrail Parameters
TOP_K=5
# Minimum cosine similarity threshold (0.0 to 1.0).
# If no retrieved chunk meets this threshold, SchemeSathi returns a grounded
# refusal without calling the LLM, preventing hallucinations and saving latency/cost.
MIN_SIMILARITY=0.65

# Client Configuration (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:5000
