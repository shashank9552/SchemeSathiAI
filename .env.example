# ==============================================================================
# SchemeSathi Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Network & Security Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (express-rate-limit)
# Protects against API flooding and LLM credit exhaustion
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# MongoDB Atlas Database & Vector Search
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=schemesathi
MONGODB_COLLECTION_NAME=scheme_chunks
ATLAS_VECTOR_INDEX_NAME=vector_index

# Model & Provider Configuration
# Supported providers: gemini (extensible to openai, ollama, etc.)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended stable Flash model (gemini-3.8-flash or gemini-2.5-flash for legacy access)
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
# Latest multimodal & text embedding model
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Embedding Vector Dimension
# gemini-embedding-2 defaults to 3072, but supports Matryoshka Representation Learning (MRL)
# down to 768 or 1536 via outputDimensionality. We configure 768 for high retrieval accuracy
# while keeping MongoDB Atlas index size efficient. Must match Atlas index definition.
EMBEDDING_DIMENSIONS=768

# RAG Ingestion & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# RAG Retrieval & Guardrail Parameters
TOP_K=5
# Number of candidate vectors to evaluate during approximate nearest neighbor search.
# Must be at least 10x-20x TOP_K (e.g., TOP_K=5 -> NUM_CANDIDATES=100) for high recall.
NUM_CANDIDATES=100

# Minimum similarity threshold for MongoDB Atlas Vector Search.
# Note on Atlas score mapping for similarity: "cosine":
# Atlas returns score = (1 + cosine_similarity) / 2, ranging strictly from 0.0 to 1.0:
#   - Score 1.00  <=> cosine 1.00  (identical direction)
#   - Score 0.70  <=> cosine 0.40  (strong relevance)
#   - Score 0.65  <=> cosine 0.30  (moderate relevance)
#   - Score 0.50  <=> cosine 0.00  (orthogonal / uncorrelated)
#   - Score 0.00  <=> cosine -1.00 (opposite direction)
# If no retrieved chunk achieves this minimum score, SchemeSathi returns a grounded
# refusal without calling the LLM, preventing hallucinations and conserving latency/API quota.
# The top retrieved score is logged on every chat request for easy threshold tuning.
MIN_SIMILARITY=0.86

# Client Configuration (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:5000
