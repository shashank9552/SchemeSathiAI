# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables (Never commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
.next/
out/

# PDF files (Do not commit binary scheme PDFs to git)
*.pdf

# Processed data cache & logs (Keep directory tracked via .gitkeep)
data/processed/*
!data/processed/.gitkeep

# Ensure raw_pdfs manifest and schemas are explicitly tracked
!data/raw_pdfs/manifest.json
!data/raw_pdfs/manifest.schema.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor caches
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
