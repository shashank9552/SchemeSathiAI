{
  "name": "schemesathi-server",
  "version": "1.0.0",
  "description": "SchemeSathi backend API and RAG ingestion service",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "ingest": "tsx src/ingestion/indexer.ts",
    "inspect:pdf": "tsx ../scripts/inspect-pdf.ts",
    "test:gemini": "tsx ../scripts/test-gemini-connection.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.13.0",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
